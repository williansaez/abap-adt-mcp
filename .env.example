# SAP Connection Settings
SAP_URL=https://example.sap-server.com:44300
SAP_CLIENT=100
SAP_LANGUAGE=EN

# ---------------------------------------------------------------------------
# Authentication — pick ONE mode
# ---------------------------------------------------------------------------

# Mode 1: Browser SSO (S/4HANA Cloud named users — like Eclipse ADT)
# Opens a real browser for SAML2/OIDC login and reuses the session cookies.
# No SAP-side configuration. Requires a local Chromium browser (Chrome/Edge/Brave).
#SAP_AUTH_TYPE=sso
#SAP_BROWSER_PATH=          # optional: path to a Chromium browser if not auto-detected
#SAP_TLS_INSECURE=false     # optional: set true only for self-signed test hosts

# Mode 2: Basic auth (on-prem, or an S/4HANA Cloud Communication User)
SAP_USER=EXAMPLE_USER
SAP_PASSWORD=your_password_here

# Mode 3: OAuth2 client_credentials (S/4HANA Cloud with a registered OAuth client)
#SAP_AUTH_TYPE=oauth
#SAP_OAUTH_TOKEN_URL=https://<tenant>/sap/bc/sec/oauth2/token
#SAP_OAUTH_CLIENT_ID=your_oauth_client_id
#SAP_OAUTH_CLIENT_SECRET=your_oauth_client_secret
#SAP_OAUTH_SCOPE=
