{
  "name": "abap-adt-mcp",
  "version": "0.3.1",
  "mcpName": "io.github.williansaez/abap-adt-mcp",
  "main": "dist/index.js",
  "bin": {
    "abap-adt-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "dev": "npx @modelcontextprotocol/inspector ./dist/index.js",
    "prepublishOnly": "npm run build",
    "tools:docs": "npm run build && node scripts/gen-tools-docs.js"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "abap-adt-api",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Willian Saez",
  "contributors": [
    "mario-andreschak (original mcp-abap-abap-adt-api)"
  ],
  "description": "Multi-destination MCP server wrapping abap-adt-api for ABAP ADT development workflows against SAP systems (basic/SSO/OAuth auth, transports, ATC, RAP generation)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williansaez/abap-adt-mcp.git"
  },
  "homepage": "https://github.com/williansaez/abap-adt-mcp#readme",
  "bugs": {
    "url": "https://github.com/williansaez/abap-adt-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.1",
    "abap-adt-api": "^8.4.3",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "puppeteer-core": "^25.9.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
