{
  "name": "abap-adt-mcp",
  "version": "1.0.1",
  "mcpName": "io.github.williansaez/abap-adt-mcp",
  "main": "dist/index.js",
  "bin": {
    "abap-adt-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "dev": "npx @modelcontextprotocol/inspector ./dist/index.js",
    "prepublishOnly": "npm run build",
    "tools:docs": "npm run build && node scripts/gen-tools-docs.js",
    "docs:check": "node scripts/check-docs-hygiene.js"
  },
  "keywords": [
    "abap",
    "sap",
    "adt",
    "abap-adt-api",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Willian Saez",
  "contributors": [
    "mario-andreschak (original mcp-abap-abap-adt-api)"
  ],
  "description": "ABAP development from Claude and other MCP hosts: read and write source, transports, unit tests, ATC, dumps, debugger. Multi-system, with server-side guard rails.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williansaez/abap-adt-mcp.git"
  },
  "homepage": "https://github.com/williansaez/abap-adt-mcp#readme",
  "bugs": {
    "url": "https://github.com/williansaez/abap-adt-mcp/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "abap-adt-api": "^8.4.3",
    "axios": "^1.20.0",
    "diff": "^9.0.0",
    "dotenv": "^16.6.1",
    "puppeteer-core": "^25.10.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.10",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "ip-address": "^10.3.1",
    "hono": "^4.12.34",
    "@hono/node-server": "^1.19.15",
    "qs": "^6.16.0",
    "brace-expansion": "^2.1.2",
    "browserslist": "^4.28.7",
    "js-yaml": "^3.15.1"
  }
}
